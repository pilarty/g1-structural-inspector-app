{
  "name": "g1-structural-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "electron:dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:8443 && electron .\"",
    "electron:preview": "cross-env ELECTRON_BUILD=true vite build && electron .",
    "electron:build": "cross-env ELECTRON_BUILD=true vite build && electron-builder",
    "electron:appx": "cross-env ELECTRON_BUILD=true vite build && electron-builder --win appx"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.g1.structuralinspector",
    "productName": "G1 Structural Inspector",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "build/runtime/backend",
        "to": "backend"
      },
      {
        "from": "build/runtime/python",
        "to": "python"
      }
    ],
    "artifactName": "G1-Structural-Inspector-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "identityName": "structuralinspector.G1StructuralInspector",
      "publisher": "CN=166404EC-CAEC-4778-BA83-9B48CDE1BCE7",
      "publisherDisplayName": "structuralinspector",
      "applicationId": "G1StructuralInspector",
      "backgroundColor": "transparent"
    }
  },
  "description": "Inspección estructural de edificios con robot humanoide",
  "author": "G1 Structural Inspector"
}
